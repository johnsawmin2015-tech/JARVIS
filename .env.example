# Required runtime configuration
# Explicit local-only switch. The application refuses DEMO_MODE=true with NODE_ENV=production.
# Demo state is process-local and resets whenever the development server restarts.
DEMO_MODE=false
# Optional local-only password when DEMO_MODE=true. Keep it in ignored .env.local.
DEMO_PASSWORD=
DATABASE_URL=postgres://jarvis:jarvis@localhost:5432/jarvis
REDIS_URL=redis://localhost:6379
AUTH_SECRET=replace-with-at-least-32-random-characters
OWNER_EMAIL=owner@example.com
# Generate with: node -e "console.log(require('crypto').scryptSync('password','salt',64).toString('hex'))"
OWNER_PASSWORD_SALT=replace-with-random-salt
OWNER_PASSWORD_HASH=replace-with-scrypt-hex

# Configure at least one model provider. Values are read server-side only.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Registry values are configuration, not hard-coded capability assumptions.
OPENAI_MODEL_ID=
ANTHROPIC_MODEL_ID=
GATEWAY_MODEL_ID=
DEFAULT_MODEL_PROVIDER=openai
# Date on which configured IDs/capabilities were checked against provider documentation.
MODEL_DOCS_VERIFIED_AT=
GATEWAY_INPUT_PRICE_PER_MILLION_USD=0
GATEWAY_OUTPUT_PRICE_PER_MILLION_USD=0
OPENAI_INPUT_PRICE_PER_MILLION_USD=0
OPENAI_OUTPUT_PRICE_PER_MILLION_USD=0
ANTHROPIC_INPUT_PRICE_PER_MILLION_USD=0
ANTHROPIC_OUTPUT_PRICE_PER_MILLION_USD=0
DAILY_BUDGET_USD=10
MONTHLY_BUDGET_USD=100
TASK_BUDGET_USD=2
JARVIS_WORKSPACE_ROOT=/absolute/path/to/JARVIS
JARVIS_SANDBOX_IMAGE=node:24-alpine
WORKER_POLL_INTERVAL_MS=1000
GITHUB_TOKEN=

# Optional object storage and telemetry
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
